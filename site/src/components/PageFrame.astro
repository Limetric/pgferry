---
import DefaultPageFrame from '@astrojs/starlight/components/PageFrame.astro';
import SpeedInsights from '@vercel/speed-insights/astro';

const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN?.trim() ?? '';
const plausibleAPI = import.meta.env.PUBLIC_PLAUSIBLE_API?.trim() ?? '';
---

<DefaultPageFrame>
	<Fragment slot="header">
		<slot name="header" />
	</Fragment>
	<Fragment slot="sidebar">
		<slot name="sidebar" />
	</Fragment>
	<slot />
	{
		plausibleDomain && (
			<>
				<script is:inline define:vars={{ plausibleAPI, plausibleDomain }}>
					window.__PGFERRY_PLAUSIBLE__ = {
						domain: plausibleDomain,
						api: plausibleAPI,
					};
				</script>
				<script>
					import { init } from '@plausible-analytics/tracker';

					const config = window.__PGFERRY_PLAUSIBLE__;
					if (config?.domain) {
						init({
							domain: config.domain,
							...(config.api ? { endpoint: config.api } : {}),
						});
					}
				</script>
			</>
		)
	}
	<SpeedInsights />
</DefaultPageFrame>
